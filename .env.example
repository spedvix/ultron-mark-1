# Environment
ULTRON_ENV=dev
TIMEZONE=Europe/Istanbul
BASE_URL=https://ultron.local

# Database
DATABASE_URL=sqlite:///./data/ultron.db

# University Portal
UNI_WEBSITE_URL=https://your-university.edu
UNI_USERNAME=
UNI_PASSWORD=
ANNOUNCEMENTS_URL=https://your-university.edu/announcements
ANNOUNCEMENT_ITEM_SELECTOR=article.post
ANNOUNCEMENT_TITLE_SELECTOR=.post_title
ANNOUNCEMENT_DATE_SELECTOR=time
ANNOUNCEMENT_CONTENT_SELECTOR=.post_content
ANNOUNCEMENT_LINK_SELECTOR=.post_title

# Notion
NOTION_API_KEY=secret_xxxxxxxxxx
NOTION_DATABASE_ID=your_database_id_here
NOTION_CALENDAR_ID=your_calendar_database_id_here
NOTION_COURSES_ID=your_courses_database_id_here

# Google Calendar
GOOGLE_CALENDAR_TOKEN_FILE=data/google_calendar_token.json
GOOGLE_CALENDAR_ASSIGNMENTS_ID=primary
GOOGLE_CALENDAR_EXAMS_ID=
GOOGLE_CALENDAR_SCHEDULE_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/Istanbul

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI (Required for Chat System)
OPENAI_API_KEY=sk-xxxxxxxxxx

# Anthropic (Optional)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# NightCrawler (Optional)
NIGHTCRAWLER_API_URL=http://localhost:8000
NIGHTCRAWLER_API_KEY=

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FILE_NAME=ultron.log

# Scheduler
SCHEDULER_TIMEZONE=Europe/Istanbul
SCHEDULER_MAX_CONCURRENCY=2
